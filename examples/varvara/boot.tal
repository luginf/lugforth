( boot.rom: shown by varvara.fs when it is started without a ROM )
( written by hand in uxntal, assemble with: uxnasm boot.tal boot.rom )
|00 @System &vector $2 &expansion $2 &wst $1 &rst $1 &metadata $2 &r $2 &g $2 &b $2
|20 @Screen &vector $2 &width $2 &height $2 &auto $1 &pad $1 &x $2 &y $2 &addr $2 &pixel $1 &sprite $1

|100
@on-reset
	( four colors: 0 background, 1 text, 2 yellow, 3 blue )
	#1ff6 .System/r DEO2  #0fcc .System/g DEO2  #3f4f .System/b DEO2
	#0150 .Screen/width DEO2  #0080 .Screen/height DEO2
	( the usage line )
	#0010 .Screen/x DEO2  #0010 .Screen/y DEO2  ;usage print
	( a rom file, a square of 3 x 3 tiles )
	;tile/solid #0028 #0048 #22 #42 draw
	;tile/solid #0028 #0050 #22 #42 draw
	;tile/solid #0028 #0058 #22 #42 draw
	#0024 .Screen/x DEO2  #0068 .Screen/y DEO2  ;rom-label print
	( the arrow )
	;tile/shaft #0060 #0050 #72 #42 draw
	;tile/head #00a0 #0050 #02 #42 draw
	( the square to drop it in: corners, then the four sides )
	;tile/tl #00b8 #0038 #02 #43 draw
	;tile/top #00c0 #0038 #42 #43 draw
	;tile/tr #00e8 #0038 #02 #43 draw
	;tile/left #00b8 #0040 #41 #43 draw
	;tile/right #00e8 #0040 #41 #43 draw
	;tile/bl #00b8 #0068 #02 #43 draw
	;tile/bottom #00c0 #0068 #42 #43 draw
	;tile/br #00e8 #0068 #02 #43 draw
	#00c4 .Screen/x DEO2  #0050 .Screen/y DEO2  ;drop-label print
	BRK

( draw: addr* x* y* auto ctrl -- )
@draw
	STH .Screen/auto DEO .Screen/y DEO2 .Screen/x DEO2 .Screen/addr DEO2
	STHr .Screen/sprite DEO
	JMP2r

( print: str* -- ; one 8x8 tile for each byte, from the space on, in color 1 )
@print
	#00 .Screen/auto DEO
	&w
		LDAk DUP ?{ POP POP2 JMP2r }
		#20 SUB #00 SWP #30 SFT2 ;font ADD2 .Screen/addr DEO2
		#41 .Screen/sprite DEO
		.Screen/x DEI2 #0008 ADD2 .Screen/x DEO2
		INC2 !&w

@usage "usage: 20 "lugforth 20 "varvara.fs 20 "program.rom 00
@rom-label ".rom 00
@drop-label "drop 00

@tile
	&solid ff ff ff ff ff ff ff ff
	&shaft 00 00 00 ff ff 00 00 00
	&head 80 c0 e0 f0 f0 e0 c0 80
	&top ff ff 00 00 00 00 00 00
	&bottom 00 00 00 00 00 00 ff ff
	&left c0 c0 c0 c0 c0 c0 c0 c0
	&right 03 03 03 03 03 03 03 03
	&tl ff ff c0 c0 c0 c0 c0 c0
	&tr ff ff 03 03 03 03 03 03
	&bl c0 c0 c0 c0 c0 c0 ff ff
	&br 03 03 03 03 03 03 ff ff

( the font: ASCII 32 to 122, 8 bytes each, only the letters of the texts are drawn )
@font
	00 00 00 00 00 00 00 00
	00 00 00 00 00 00 00 00
	00 00 00 00 00 00 00 00
	00 00 00 00 00 00 00 00
	00 00 00 00 00 00 00 00
	00 00 00 00 00 00 00 00
	00 00 00 00 00 00 00 00
	00 00 00 00 00 00 00 00
	00 00 00 00 00 00 00 00
	00 00 00 00 00 00 00 00
