( The uxntal twin of bench_lines.fs / bench_lines.c: same 100 lines (a 16-bit
  LCG, same constants, picks their endpoints), same Bresenham, same 50
  redraws through the real Screen device (one DEO per pixel: .Screen/x,
  .Screen/y, .Screen/pixel), so the three are comparable. uxntal has no
  built-in signed compare, so the two branches of Bresenham's error term
  (which can go negative) are done by hand: is-neg tests the top bit of a
  16-bit two's complement subtraction, ADD2/SUB2 wrap correctly either way,
  only the comparisons need this care. Line endpoints are stored 4 bytes
  apart (x0,y0,x1,y1) starting at 0x0400, well clear of the code. Prints a
  checksum of every plotted (x,y) mod 65536, reset each frame (the lines are
  the same every frame, so only the last value matters): expect 6942 (hex).
    uxnasm examples/bench_lines.tal bench_lines.rom && uxncli bench_lines.rom
  Or, for a real window left open on the drawing (uxncli has none):
    uxnasm examples/bench_lines.tal bench_lines.rom && uxnemu bench_lines.rom )

|00 @vars
  &lcg $2  &checksum $2
  &X0 $2   &Y0 $2   &X1 $2   &Y1 $2
  &dx $2   &sx $2   &dy $2   &sy $2   &err $2   &e2 $2
  &x $2    &y $2    &addr $2 &frame $2

|00 @System [ &vector $2 &pad $6 &r $2 &g $2 &b $2 ]
|10 @Console [ &vector $2 &read $1 &pad $5 &write $1 &error $1 ]
|20 @Screen [ &vector $2 &width $2 &height $2 &pad $2 &x $2 &y $2 &addr $2 &pixel $1 &sprite ]
|80 @Controller [ &vector $2 &button $1 &key $1 ]

|0100
@reset
	( default palette is all black: set color 0 (background) to black and
	  color 1 (what &pixel/#01 draws) to white, or the lines would be
	  invisible -- correct but unwatchable )
	#0f00 .System/r DEO2
	#0f00 .System/g DEO2
	#0f00 .System/b DEO2
	#0100 .Screen/width DEO2
	#0100 .Screen/height DEO2
	;gen-lines JSR2
	#0032 .vars/frame STZ2
	&frame-loop
		#0000 .vars/checksum STZ2
		#0400 .vars/addr STZ2
		&line-loop
			#00 .vars/addr LDZ2 LDA .vars/X0 STZ2
			#00 .vars/addr LDZ2 #0001 ADD2 LDA .vars/Y0 STZ2
			#00 .vars/addr LDZ2 #0002 ADD2 LDA .vars/X1 STZ2
			#00 .vars/addr LDZ2 #0003 ADD2 LDA .vars/Y1 STZ2
			;draw-line JSR2
			.vars/addr LDZ2 #0004 ADD2 DUP2 .vars/addr STZ2
			#0590 NEQ2 ;&line-loop JCN2
		.vars/frame LDZ2 #0001 SUB2 DUP2 .vars/frame STZ2
		#0000 NEQ2 ;&frame-loop JCN2
	;print-checksum JSR2
	( keep the window (uxnemu) open on the last frame so the drawing can be
	  checked by eye: a registered vector is what keeps its event loop
	  running instead of exiting right after reset; uxncli ignores it )
	;on-button .Controller/vector DEO2
BRK

@on-button ( -- ) BRK

@gen-lines ( -- )
	#0001 .vars/lcg STZ2
	#0400 .vars/addr STZ2
	&loop
		;lcg-next JSR2
		.vars/lcg LDZ2 NIP  .vars/addr LDZ2 STA
		.vars/lcg LDZ2 POP  .vars/addr LDZ2 #0001 ADD2 STA
		;lcg-next JSR2
		.vars/lcg LDZ2 NIP  .vars/addr LDZ2 #0002 ADD2 STA
		.vars/lcg LDZ2 POP  .vars/addr LDZ2 #0003 ADD2 STA
		.vars/addr LDZ2 #0004 ADD2 DUP2 .vars/addr STZ2
		#0590 NEQ2 ;&loop JCN2
JMP2r

@lcg-next ( -- )
	.vars/lcg LDZ2 #6255 MUL2 #3619 ADD2 .vars/lcg STZ2
JMP2r

@is-neg ( d* -- flag )
	#8000 AND2 #0000 NEQ2
JMP2r

@abs16 ( n* -- |n|* )
	DUP2 #8000 AND2 #0000 EQU2 ;&pos JCN2
		#0000 SWP2 SUB2 JMP2r
	&pos
JMP2r

@bl-plot ( -- )
	.vars/x LDZ2 #0003 MUL2 .vars/checksum LDZ2 ADD2 .vars/checksum STZ2
	.vars/y LDZ2 #0007 MUL2 .vars/checksum LDZ2 ADD2 .vars/checksum STZ2
	.vars/x LDZ2 .Screen/x DEO2
	.vars/y LDZ2 .Screen/y DEO2
	#01 .Screen/pixel DEO
JMP2r

@draw-line ( -- )
	.vars/X1 LDZ2 .vars/X0 LDZ2 SUB2 ;abs16 JSR2 .vars/dx STZ2
	.vars/X0 LDZ2 .vars/X1 LDZ2 LTH2 ;&sxpos JCN2
		#ffff .vars/sx STZ2 ;&sxdone JMP2
	&sxpos #0001 .vars/sx STZ2
	&sxdone
	.vars/Y1 LDZ2 .vars/Y0 LDZ2 SUB2 ;abs16 JSR2 #0000 SWP2 SUB2 .vars/dy STZ2
	.vars/Y0 LDZ2 .vars/Y1 LDZ2 LTH2 ;&sypos JCN2
		#ffff .vars/sy STZ2 ;&sydone JMP2
	&sypos #0001 .vars/sy STZ2
	&sydone
	.vars/dx LDZ2 .vars/dy LDZ2 ADD2 .vars/err STZ2
	.vars/X0 LDZ2 .vars/x STZ2
	.vars/Y0 LDZ2 .vars/y STZ2
	&loop
		;bl-plot JSR2
		.vars/x LDZ2 .vars/X1 LDZ2 NEQ2
		.vars/y LDZ2 .vars/Y1 LDZ2 NEQ2
		ORA #00 EQU ;&end JCN2
			.vars/err LDZ2 #10 SFT2 .vars/e2 STZ2
			.vars/e2 LDZ2 .vars/dy LDZ2 SUB2 ;is-neg JSR2 ;&c1f JCN2
				.vars/dy LDZ2 .vars/err LDZ2 ADD2 .vars/err STZ2
				.vars/sx LDZ2 .vars/x LDZ2 ADD2 .vars/x STZ2
			&c1f
			.vars/dx LDZ2 .vars/e2 LDZ2 SUB2 ;is-neg JSR2 ;&c2f JCN2
				.vars/dx LDZ2 .vars/err LDZ2 ADD2 .vars/err STZ2
				.vars/sy LDZ2 .vars/y LDZ2 ADD2 .vars/y STZ2
			&c2f
		;&loop JMP2
	&end
JMP2r

( ---- console output ---- )
@emit ( c -- ) .Console/write DEO JMP2r
@emit-nib ( n -- ) DUP #0a LTH ;&d JCN2 #0a SUB #41 ADD ;emit JSR2 JMP2r &d #30 ADD ;emit JSR2 JMP2r
@emit-hexb ( b -- ) DUP #04 SFT ;emit-nib JSR2 #0f AND ;emit-nib JSR2 JMP2r
@emit-str ( ptr* -- )
	&loop DUP2 LDA #00 EQU ;&done JCN2 DUP2 LDA ;emit JSR2 INC2 ;&loop JMP2 &done POP2 JMP2r

@print-checksum ( -- )
	;s-result ;emit-str JSR2
	.vars/checksum LDZ2 SWP ;emit-hexb JSR2 ;emit-hexb JSR2
	#0a ;emit JSR2
JMP2r

@s-result "checksum: 20 $1
